{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": ["shared-contracts/**/*.ts", "foundation/**/*.ts", "value-engines/**/*.ts", "feed/**/*.ts", "briefing/**/*.ts", "composition/**/*.ts", "http/**/*.ts", "core/**/*.ts", "public-export/**/*.ts", "accounting/**/*.ts", "inventory/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
