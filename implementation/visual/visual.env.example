# Visual product search (D-91). No secrets here: the model is public and runs locally.
# Enables the feature (directory outside git, filled once with `visual-model-fetch`).
VISUAL_MODEL_DIR=/opt/mlino/models/dinov2-small/8b1f705
# Holds media/sha256/… of the public export (default: the directory of CATALOG_PATH).
VISUAL_MEDIA_ROOT=/var/www/mlino-public-export
# Cosine threshold for «similar»; evaluated with `visual-eval` (see visual/README.md).
VISUAL_MIN_SIMILARITY=0.5
# CPU threads for the model (the VPS has 2 cores shared with other services).
VISUAL_THREADS=1
