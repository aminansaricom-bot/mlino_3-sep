    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "prisma": "5.22.0",
