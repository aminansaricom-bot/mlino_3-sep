{
  "name": "mlino-v1-core",
  "version": "0.1.0",
  "private": true,
  "description": "MLINO V1 Core implementation scaffold — Wave 1 (Foundation FP-01/FP-03 + Value Engines F-01/F-02/F-03 + Feed/Briefing F-04/F-05, against mocked IC-14 read path).",
  "main": "dist/index.js",
