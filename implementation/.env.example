DATABASE_URL="postgresql://mlino:mlino_dev_local@localhost:5435/mlino_v1?schema=public"

# REMEDIATION R7 (Central Review — JWT fail-closed): REQUIRED, no default.
# FP-03 (foundation/auth-adapter/auth-adapter.ts) refuses to sign or verify
# any token if this is unset — it fails closed rather than falling back to
# an insecure built-in value. Generate a strong, unique random value per
# environment; do NOT reuse this placeholder anywhere shared or production.
MLINO_JWT_SECRET="replace-with-a-strong-random-secret-per-environment"
