app.mlino.site {
    root * /var/www/mlino-entry
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Cache-Control "no-cache"
    }
    try_files {path} /index.html
    file_server
}

business.mlino.site {
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "microphone=(self), camera=(), geolocation=()"
    }
    handle_path /public-export/* {
        root * /var/www/mlino-public-export
        @json path /public-business.v1.json /public-catalog.v1.json
        handle @json {
            header Cache-Control "no-store, max-age=0"
            file_server
        }
        @media path /media/sha256/*
        handle @media {
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        respond 404
    }
    handle /assets/* {
        root * /var/www/mlino-business
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /var/www/mlino-business
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

explore.mlino.site {
    encode gzip
    header {
        Permissions-Policy "camera=(self), gyroscope=(self), accelerometer=(self), magnetometer=(self), geolocation=(self)"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    handle /assistant/* {
        respond 404
    }
    handle_path /public-export/* {
        root * /var/www/mlino-public-export
        @json path /public-business.v1.json /public-catalog.v1.json
        handle @json {
            header Cache-Control "no-store, max-age=0"
            file_server
        }
        @media path /media/sha256/*
        handle @media {
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        respond 404
    }
    handle /version.json {
        root * /var/www/mlino-v2
        header Cache-Control "no-store, max-age=0"
        file_server
    }
    handle /assets/* {
        root * /var/www/mlino-v2
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /var/www/mlino-v2
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
